      "title": "短剧提示词 JSON（外部输入）",
      "properties": {
        "Node name for S&R": "PrimitiveStringMultiline",
        "cnr_id": "comfy-core",
        "ver": "0.30.0",
        "ue_properties": {
          "widget_ue_connectable": {},
