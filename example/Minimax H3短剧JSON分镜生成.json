        "widget_ue_connectable": {}
      },
      "widgets_values": [
        "{\n  \"整体风格\": \"3D CG写实数字人，古代东方市井武侠质感；青绿绸缎、暗色劲装、粗布短褐与补丁破衣质感分明；分镜1-2为白天硬日光，分镜3-5为夜晚灯火与红灯笼暖光\",\n  \"角色图片\": {\n    \"杀手\": \"中年男子，黑发高束成髻，黑绳垂落，面容肃冷，穿深蓝近黑交领短袍，肩披灰黑双色短披风，腰系黑皮带与暗红绳穗，小臂缠黑布，胯佩黑鞘单刀，暗红缠柄\",\n    \"地主\": \"中年男子，面容憨厚略带风霜，短黑发向上梳理，留短须茬，穿米褐色粗布交领短袖布扣衫，下着深灰粗布短裤，足蹬黑布薄底鞋\",\n    \"店小二\": \"约十岁女孩，双丫髻，眉眼机灵带笑意，穿青蓝交领短褐与短裤，腰系污白破边围裙，足蹬草编凉鞋，神色表面乖巧\"\n  },\n  \"场景图片\": {\n    \"杀手住所\": \"高夯土墙围起的僻静小院，青灰砖小平房，深色瓦檐，木门半掩贴白纸帖，旁有纸糊方格木窗。檐下摆木板床与薄褐褥枕，院中粗木桌放褐陶提梁壶，旁有小木凳。石砖地缝生苔，左角一株小树根脚围石，白天硬日光斜照，明暗反差大，冷清隐蔽\",\n    \"酒楼内部\": \"酒楼内堂（勿拍门外夜街与门匾外景）；白天时左侧木格花窗泻入强烈暖阳光柱、尘埃浮动；夜晚时窗外墨蓝、以室内油灯与柜前暖光为主。右侧长柜与多层木架堆满陶碗酒坛，斑驳白墙正中贴「春酒春」大字，灰石地砖，剥落红漆木柱，方桌长凳与陶壶酒碗\"\n  },\n  \"镜头规则\": \"各分镜均使用越肩镜头硬切，只切说话人面部特写；场景与人物引用统一写尖括号，如 <酒楼内部>、<酒店老板>，须与角色图片/场景图片名称一致；同一分镜内时段、衣着、站位与场景不变；对白口型同步，单句控制在五秒内说完\",\n  \"分镜序列\": {\n    \"分镜1\": [\n      {\n        \"编号\": 1,\n        \"时长\": \"3s\",\n        \"镜头\": \"越肩硬切，<地主>面部特写\",\n        \"画面\": \"白天。<酒楼内部>角落方桌，木格窗阳光柱斜照，<地主>与<店小二>对坐密谋。焦点在<地主>：端起酒碗虚掩嘴边，眼神阴沉，嘴唇微动\",\n        \"对白\": {\n          \"地主\": \"今夜把掌柜灌醉，亥时动手。\"\n        },\n        \"声音\": \"白日酒楼低语、碗沿轻碰、窗外市井远响，对白压低清晰，口型同步\"\n      },\n      {\n        \"编号\": 2,\n        \"时长\": \"2s\",\n        \"镜头\": \"越肩硬切，<店小二>面部特写\",\n        \"画面\": \"仍是白天，仍在<酒楼内部>，切到<店小二>面部，青衣围裙女孩凑近点头，表面乖巧，眼神发亮，后景长柜酒坛\",\n        \"对白\": {\n          \"店小二\": \"好酒备足了，灌醉他就行。\"\n        },\n        \"声音\": \"接续白日酒楼环境音，童声压低带笑意，口型同步，停在密谋对视\"\n      }\n    ],\n    \"分镜2\": [\n      {\n        \"编号\": 2,\n        \"时长\": \"2s\",\n        \"镜头\": \"越肩硬切，<杀手>面部特写\",\n        \"画面\": \"仍是白天，仍在<杀手住所>，切到<杀手>面部，拇指按刀柄，微微颔首，眼神肃冷应令\",\n        \"对白\": {\n          \"杀手\": \"怎么动手?\"\n        },\n        \"声音\": \"接续小院日间环境音、刀鞘轻碰，嗓音低沉，口型同步，停在短暂对视\"\n      },\n{\n        \"编号\": 1,\n        \"时长\": \"3s\",\n        \"镜头\": \"越肩硬切，<地主>面部特写\",\n        \"画面\": \"白天。<杀手住所>檐下硬日影，木板床与陶壶虚焦在侧，<地主>对<杀手>下令。焦点在<地主>：压低嗓音，神色阴沉\",\n        \"对白\": {\n          \"地主\": \"小二灌醉他。你侧门进，下手干净。\"\n        },\n        \"声音\": \"小院蝉鸣、衣料轻擦，对白压低清晰，口型同步\"\n      }\n    ]\n  }\n}\n"
      ],
